# Copy to .env, fill in real values, never commit .env.
# Generate every secret/password below with:  openssl rand -hex 32
# (or any other source of 32+ random bytes). The back's SecretGuard
# refuses to start if a placeholder ("change_me", "dev-secret", etc.)
# slips through, so do this before the first `docker compose up -d`.

# Postgres (app database — owned by the back service)
DB_NAME=qui_est_ce
DB_USERNAME=qui_est_ce
DB_PASSWORD=change_me

# Postgres (keycloak database — created by postgres/init/00-keycloak-db.sh on first volume init)
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change_me

# Keycloak bootstrap admin (used only on first boot to log into the admin console)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change_me

# MinIO / S3 (also acts as the access/secret pair the back uses to talk to MinIO)
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me

# Keycloak client secrets — substituted into realm-export-prod.json at first
# import via ${VAR} placeholders, so set them BEFORE the first boot.
# OIDC_CLIENT_SECRET   → qui-est-ce-back  (token validation; resource server)
# KEYCLOAK_ADMIN_SECRET → qui-est-ce-admin (M2M client_credentials, manage-users)
# Must be different — the back's SecretGuard rejects equal values.
OIDC_CLIENT_SECRET=change_me
KEYCLOAK_ADMIN_SECRET=change_me
