# À copier en `.env` (chmod 600), jamais commité. Voir docs/homelab-setup.md §14.

# Même version pour le hub et l'agent. Releases : https://github.com/henrygd/beszel/releases
BESZEL_VERSION=0.21.1
BESZEL_DATA_LOCATION=/opt/homelab/beszel
# URL du hub sur le tailnet (liens dans les notifications).
BESZEL_APP_URL=https://homelab.<tailnet>.ts.net:8090
# Fournis par le hub (« Add system ») au premier lancement.
BESZEL_KEY="ssh-ed25519 AAAA..."
BESZEL_TOKEN=
# Optionnel : URL de ping healthchecks.io (https://hc-ping.com/<uuid>).
BESZEL_HEARTBEAT_URL=
# Optionnel : interfaces affichées, ex. eno1,tailscale0 (cf. `ip -br link`).
BESZEL_NICS=
