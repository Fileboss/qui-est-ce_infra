# À installer en /etc/vaultwarden-backup.env (root:root, chmod 600)

VW_DATA_DIR=/opt/homelab/vaultwarden/data
# "vps-backup" est un alias défini dans /root/.ssh/config (cf. procédure).
RESTIC_REPOSITORY=sftp:vps-backup:/repo
RESTIC_PASSWORD_FILE=/root/.config/restic/password
# Optionnel : URL de ping healthchecks.io (sans slash final).
# HC_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optionnel : URL de ping healthchecks.io du backup simple-finance (§15).
# FINANCE_HC_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optionnel : URL de ping healthchecks.io du backup Memos (§16).
# MEMOS_HC_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
