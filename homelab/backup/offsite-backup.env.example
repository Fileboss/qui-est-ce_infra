# À installer en /etc/offsite-backup.env (root:root, chmod 600)

# IP tailnet du PC des parents (tailscale ip -4 sur le PC, §18.3).
OFFSITE_HOST=100.x.y.z
# Mot de passe de l'utilisateur "homelab" du rest-server (htpasswd, §18.4).
OFFSITE_REST_PASSWORD=change_me
# Même mot de passe restic que les autres dépôts (§9.3) : une seule clé à garder hors du HP.
RESTIC_PASSWORD_FILE=/root/.config/restic/password
# Clé SSH qui ne sert qu'à éteindre le PC (§18.5).
OFFSITE_SSH_KEY=/root/.ssh/offsite_power
# no : laisse le PC allumé à la fin (ex. pendant une visite où tu t'en sers).
OFFSITE_POWEROFF=yes
# Optionnel : plafond d'envoi en Kio/s, pour ne pas saturer l'upload de ta box.
# OFFSITE_LIMIT_UPLOAD=5000
# Optionnel : URL de ping healthchecks.io (sans slash final). Période 60 jours + marge
# 14 jours, à ajuster au rythme de tes visites.
# OFFSITE_HC_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
