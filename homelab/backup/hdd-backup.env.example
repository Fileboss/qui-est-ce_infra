# À installer en /etc/hdd-backup.env (root:root, chmod 600)

# UUID du système de fichiers du disque USB : sudo blkid (ligne du disque, champ UUID).
HDD_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Type de système de fichiers, vide = détection automatique (ext4, exFAT).
# Disque NTFS (format d'usine des WD Elements) : ntfs-3g (sudo apt install ntfs-3g).
# Sans ça, mount ne reconnaît pas le type « ntfs » sur Debian 13.
# HDD_FSTYPE=ntfs-3g
# Point de montage temporaire, le temps du backup.
HDD_MOUNT=/mnt/backup-hdd
# Dossier du dépôt restic sur le disque.
HDD_REPO_DIR=homelab-restic
# Même mot de passe que le dépôt du VPS (§9.3) : une seule clé à garder hors du HP.
RESTIC_PASSWORD_FILE=/root/.config/restic/password
# Optionnel : URL de ping healthchecks.io (sans slash final). Période 31 jours + marge
# 7 jours : te prévient aussi si tu oublies le backup du mois.
# HDD_HC_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
