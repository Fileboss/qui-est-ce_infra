[Unit]
Description=Backup chiffré de simple-finance vers le VPS
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/finance-backup.sh
Nice=10
IOSchedulingClass=idle
# Durcissement
PrivateTmp=true
NoNewPrivileges=true
