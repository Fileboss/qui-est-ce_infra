# À copier en `.env` sur le HP (chmod 600), jamais commité.

# --- Immich -----------------------------------------------------------------
# Photos/vidéos : dossier sur le SSD unique ; point de montage d'un futur SSD 2,5" (voir docs §2.4).
UPLOAD_LOCATION=/mnt/data/immich/library
# Base Postgres : sur le SSD NVMe (rapide). Pas de partage réseau.
DB_DATA_LOCATION=/opt/homelab/immich/postgres
TZ=Europe/Paris
# Suit la branche majeure v3. Pour figer : v3.3.1
IMMICH_VERSION=v3
# openssl rand -hex 24   (uniquement A-Za-z0-9)
DB_PASSWORD=change_me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# Caddy (VPS) -> tailnet -> `tailscale serve` -> Immich : la connexion arrive de tailscaled
# en local (127.0.0.1), pas de l'IP tailnet du VPS. On fait confiance à localhost pour lire
# l'IP réelle du client dans X-Forwarded-For.
IMMICH_TRUSTED_PROXIES=127.0.0.1,::1

# --- Vaultwarden ------------------------------------------------------------
VAULTWARDEN_VERSION=1.37.4
# URL publique, identique au bloc du Caddyfile du VPS (schéma inclus).
VW_DOMAIN=https://vault.lepgu.fr
VW_DATA_LOCATION=/opt/homelab/vaultwarden/data
# true uniquement pendant la création des 2 comptes.
VW_SIGNUPS_ALLOWED=false
