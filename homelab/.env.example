# À copier en `.env` sur le HP (chmod 600), jamais commité.

# --- Immich -----------------------------------------------------------------
# Photos/vidéos : sur le SSD 500 Go.
UPLOAD_LOCATION=/mnt/data/immich/library
# Base Postgres : sur le SSD système (rapide). Pas de partage réseau.
DB_DATA_LOCATION=/opt/homelab/immich/postgres
TZ=Europe/Paris
# Suit la branche majeure v3. Pour figer : v3.3.1
IMMICH_VERSION=v3
# openssl rand -hex 24   (uniquement A-Za-z0-9)
DB_PASSWORD=change_me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# --- Vaultwarden ------------------------------------------------------------
VAULTWARDEN_VERSION=1.37.4
# URL publique, identique au bloc du Caddyfile du VPS (schéma inclus).
VW_DOMAIN=https://vault.lepgu.fr
VW_DATA_LOCATION=/opt/homelab/vaultwarden/data
# true uniquement pendant la création des 2 comptes.
VW_SIGNUPS_ALLOWED=false
