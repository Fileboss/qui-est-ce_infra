# À copier en `.env` (chmod 600), jamais commité. Voir docs/homelab-setup.md §16.

# Releases : https://github.com/usememos/memos/releases (image : tag sans le "v", ex. 0.31.0).
# Ne monter qu'une fois la version annoncée supportée par MoeMemos :
# https://github.com/mudkipme/MoeMemos/releases
MEMOS_VERSION=0.31.0
MEMOS_DATA_LOCATION=/opt/homelab/memos
MEMOS_INSTANCE_URL=https://notes.lepgu.fr
MEMOS_CPUS=1
