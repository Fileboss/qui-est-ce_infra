# En-têtes communs aux services exposés depuis le homelab.
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

# Jeu qui-est-qui arrêté (plus maintenu) : plus aucun proxy vers front/back/Keycloak/MinIO.
# Les noms restent servis pour répondre proprement au lieu d'une erreur TLS.
# Ancienne config : historique git (avant le commit qui a ajouté ce bloc).
qui-est-qui.lepgu.fr, api.qui-est-qui.lepgu.fr, auth.qui-est-qui.lepgu.fr, s3.qui-est-qui.lepgu.fr {
    import security_headers
    respond "Service arrêté." 410
}

# --- Homelab (HP à la maison, joint via Tailscale ; aucun port ouvert sur la box) ---
# HOMELAB_TAILNET_IP = IP 100.x.y.z du HP sur le tailnet (cf. docs/homelab-setup.md).
# Le VPS termine le TLS puis relaie dans le tunnel WireGuard de Tailscale.

photos.lepgu.fr {
    import security_headers
    # Pas de limite de taille de requête par défaut dans Caddy : les vidéos
    # volumineuses envoyées par l'app mobile passent.
    reverse_proxy {$HOMELAB_TAILNET_IP}:2283 {
        transport http {
            dial_timeout 5s
        }
    }
}

notes.lepgu.fr {
    import security_headers
    reverse_proxy {$HOMELAB_TAILNET_IP}:5230 {
        transport http {
            dial_timeout 5s
        }
    }
}

vault.lepgu.fr {
    import security_headers

    # Panneau d'admin Vaultwarden jamais exposé sur Internet (il est de toute
    # façon désactivé : pas d'ADMIN_TOKEN côté HP).
    @admin path /admin /admin/*
    respond @admin "Forbidden" 403

    reverse_proxy {$HOMELAB_TAILNET_IP}:8222 {
        # Vaultwarden lit l'IP cliente dans X-Real-IP (IP_HEADER) pour son rate-limit.
        header_up X-Real-IP {remote_host}
        transport http {
            dial_timeout 5s
        }
    }
}
