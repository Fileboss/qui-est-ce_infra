qui-est-qui.lepgu.fr {
    # handle_path strips the matched prefix before forwarding, mirroring the
    # frontend's dev proxy.conf.json which rewrites ^/api -> "". The back
    # exposes endpoints at /pack, /game/*, etc. — no /api prefix.
    handle_path /api/* {
        reverse_proxy back:8080
    }
    # WebSockets keep the /ws prefix: backend endpoints are /ws/game/{id} and
    # /ws/games literally, and the dev proxy passes them through unchanged.
    handle /ws/* {
        reverse_proxy back:8080
    }
    handle {
        reverse_proxy front:80
    }
}

api.qui-est-qui.lepgu.fr {
    reverse_proxy back:8080
}

auth.qui-est-qui.lepgu.fr {

    @admin path /admin* /admin/*

    @admin_from_home {
        path /admin* /admin/*
        remote_ip 88.182.11.181 2a01:e0a:d82:ed50:edec:7440:be84:55e3::/64
    }

    handle @admin_from_home {
        reverse_proxy keycloak:8080
    }

    #@kc_admin path /admin/* /realms/master/*
    #basic_auth @kc_admin {
    #    admin {$KC_ADMIN_BASIC_AUTH_HASH}
    #}

    respond @admin "Forbidden 403"

    reverse_proxy keycloak:8080
}

s3.qui-est-qui.lepgu.fr {
    reverse_proxy minio:9000
}
